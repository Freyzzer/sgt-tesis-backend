# Copie este archivo a ".env" (que NO se versiona) y reemplace cada valor por uno propio y distinto.
# Estos valores son SOLO para el entorno local con docker compose; nunca los reutilice en Staging ni Producción.

# Contraseña del administrador de SQL Server local (mínimo 8 caracteres con mayúscula, minúscula, número y símbolo).
MSSQL_SA_PASSWORD=CAMBIE-ESTE-VALOR-1a!

# Contraseñas de los usuarios de la base de datos (la política de SQL Server exige complejidad).
# Evite comillas simples en estos valores.
APP_DB_PASSWORD=CAMBIE-ESTE-VALOR-2b!
MIGRATOR_DB_PASSWORD=CAMBIE-ESTE-VALOR-3c!

# Clave de firma de los tokens (32 caracteres o más, aleatoria).
JWT_SIGNING_KEY=CAMBIE-ESTE-VALOR-por-una-cadena-aleatoria-larga-0123456789

# Primer Administrador (se crea solo si aún no existe ninguno).
ADMIN_CORREO=admin@institucion.edu
ADMIN_PASSWORD=CAMBIE-ESTE-VALOR-4d!

# Opcional: solicitudes por minuto al login (útil al correr pruebas de carga).
# LOGIN_PERMIT_PER_MINUTE=10

# Puerto local de SQL Server (por defecto 14330 para no chocar con una instancia instalada en 1433).
# DB_HOST_PORT=14330
